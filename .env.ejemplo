# Copiar a .env y ajustar. Ese archivo NO se versiona.
#
#   cp .env.ejemplo .env

# Secreto compartido con el REST API. Tiene que coincidir con la variable
# CONFIG_API_KEY del proyecto en Vercel, o la cache recibira 401 al pedir su
# configuracion y no arrancara.
CONFIG_API_KEY=ABCDEFG

# Donde vive el REST API que guarda dominios, reglas y usuarios.
# Por omision, el desplegado en Vercel.
NODE_API_HOST=zonal-cache-rest-api-nodejs.vercel.app
NODE_API_PORT=443
NODE_API_TLS=1
UI_PORT=443

# Dominios que administra la plataforma. Los demas se reenvian a DNS_EXTERNO.
DOMINIOS_PROPIOS=crhoy.com,api.demo.cr,sitio.demo.cr,httpforever.com
DNS_EXTERNO=8.8.8.8

# Terminacion TLS de la cache. En 1 hay que montar ademas el certificado.
TLS_HABILITADO=0

# Puerto del anfitrion para el interceptor. No use 53 (systemd-resolved)
# ni 5353 (mDNS/avahi).
PUERTO_DNS=5300

# Puertos del anfitrion. Cambielos si alguno ya esta ocupado.
PUERTO_APACHE=8081
PUERTO_JAVA=7070
PUERTO_CACHE=9777
